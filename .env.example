# Groq API key (get yours at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Text model for text-only roasts & clapbacks (default: openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Vision model for photos & duo webcam battles (must support vision, e.g. qwen/qwen3.8-27b; falls back to qwen/qwen3.6-27b automatically)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

